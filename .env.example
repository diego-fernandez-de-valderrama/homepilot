# Copy to .env and fill in. Never commit .env.
# GEMINI_*, POSTGRES_* and QDRANT_* are the same variables as in ../catalog-ingestion/.env
# (read by the reused catalog_ingestion settings classes). Use the same values there and here.

# --- Gemini (chat model via Google ADK; query embeddings via the ingestion embedder) ---
GEMINI_API_KEY=
# Must match the model/dimension used to build the Qdrant index (checked at startup).
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768
GEMINI_MAX_RETRIES=8
# GEMINI_EMBEDDING_REQUESTS_PER_MINUTE=90

# --- PostgreSQL (started by ../catalog-ingestion/docker-compose.yml) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=catalog
POSTGRES_USER=catalog
POSTGRES_PASSWORD=change-me

# --- Qdrant (started by ../catalog-ingestion/docker-compose.yml) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=products

# --- Agent ---
AGENT_MODEL=gemini-2.5-flash
AGENT_TEMPERATURE=0.2
# Thinking tokens per call: 0 = off (default; the dynamic default caused frequent empty answers), -1 = model default
AGENT_THINKING_BUDGET=0
# Silent retries of empty answers / transient HTTP errors (exponential backoff: 1s, 2s, 4s, capped at 8s)
AGENT_MODEL_RETRIES=3
AGENT_MODEL_RETRY_INITIAL_DELAY=1.0
AGENT_MODEL_RETRY_MAX_DELAY=8.0
AGENT_CANDIDATE_POOL=50
AGENT_UPSELL_MIN_RELEVANCE=0.75

# --- Guardrail (semantic input check + deterministic output check) ---
# false = switch off (no prototype embedding at startup, every message goes to the agent as before)
AGENT_GUARDRAIL_ENABLED=true
AGENT_GUARDRAIL_OUTPUT_CHECK=true
# Calibrated with `uv run python -m smart_home_agent guardrail-eval --sweep`
AGENT_GUARDRAIL_THRESHOLD_SMART_HOME=0.70
AGENT_GUARDRAIL_THRESHOLD_ELECTRICAL=0.78
AGENT_GUARDRAIL_THRESHOLD_OFF_TOPIC=0.66
AGENT_GUARDRAIL_THRESHOLD_PROMPT_INJECTION=0.70
AGENT_GUARDRAIL_MARGIN=0.005
# OFF_TOPIC only: larger lead and a minimum message length (used by the output check; and at input if enabled)
AGENT_GUARDRAIL_OFF_TOPIC_MARGIN=0.01
AGENT_GUARDRAIL_OFF_TOPIC_MIN_WORDS=3
# Off-topic is handled by the output check by default; true = also block confident OFF_TOPIC messages at input
AGENT_GUARDRAIL_INPUT_OFF_TOPIC=false

# --- Customer memory (separate database on the same PostgreSQL server; `python -m smart_home_agent init-memory`) ---
AGENT_MEMORY_ENABLED=true
AGENT_MEMORY_DB=homepilot_memory
# Streamlit testing controls (customer picker, developer panel, stored data): they list every stored
# customer's facts to anyone with the URL. Set false for any shared deployment.
AGENT_UI_DEV_TOOLS=true
