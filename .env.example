# Copy to .env and fill in. Never commit .env.
# GEMINI_*, POSTGRES_* and QDRANT_* are the same variables as in ../catalog-ingestion/.env
# (read by the reused catalog_ingestion settings classes). Use the same values there and here.

# --- Gemini (chat model via Google ADK; query embeddings via the ingestion embedder) ---
GEMINI_API_KEY=
# Must match the model/dimension used to build the Qdrant index (checked at startup).
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768
GEMINI_MAX_RETRIES=8
# GEMINI_EMBEDDING_REQUESTS_PER_MINUTE=90

# --- PostgreSQL (started by ../catalog-ingestion/docker-compose.yml) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=catalog
POSTGRES_USER=catalog
POSTGRES_PASSWORD=change-me

# --- Qdrant (started by ../catalog-ingestion/docker-compose.yml) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=products

# --- Agent ---
AGENT_MODEL=gemini-2.5-flash
AGENT_TEMPERATURE=0.2
AGENT_CANDIDATE_POOL=50
AGENT_UPSELL_MIN_RELEVANCE=0.75
