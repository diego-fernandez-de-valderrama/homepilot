# Copy to .env and fill in. Never commit .env.
# Prefixes map 1:1 to the settings classes in src/catalog_ingestion/core/settings.py.

# --- Gemini (LLM enrichment, url_context page reading, embeddings) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768
GEMINI_TEMPERATURE=0.0
# Client-side pacing (requests per minute). Leave unset on paid tiers.
# Free tier: set just below your quota, e.g. 14 for a 15 RPM model (see https://ai.dev/rate-limit).
# GEMINI_REQUESTS_PER_MINUTE=14
# GEMINI_EMBEDDING_REQUESTS_PER_MINUTE=90
GEMINI_MAX_RETRIES=8

# --- PostgreSQL (also read by docker-compose.yml) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=catalog
POSTGRES_USER=catalog
POSTGRES_PASSWORD=change-me

# --- Qdrant (QDRANT_API_KEY is optional locally; also read by docker-compose.yml) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=products
QDRANT_HTTP_PORT=6333

# --- Web fetching of product pages ---
WEB_ENABLED=true
WEB_TIMEOUT_SECONDS=15
WEB_MAX_TEXT_CHARS=20000
# WEB_USER_AGENT=...

# --- Ingestion ---
INGEST_INPUT_PATH=../products.zip
INGEST_CONCURRENCY=4
