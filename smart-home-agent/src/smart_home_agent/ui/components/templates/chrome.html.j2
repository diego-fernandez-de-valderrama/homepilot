{% macro masthead() %}
  <header class="hp-masthead">
    <div class="hp-masthead__mark" aria-hidden="true"></div>
    <div class="hp-masthead__brand">
      <span class="hp-masthead__name">HomePilot</span>
      <span class="hp-masthead__tag">Smart home advisor · Smart-Home-Beratung</span>
    </div>
    <span class="hp-masthead__meta">Catalog-verified answers</span>
  </header>
{% endmacro %}

{% macro intro(capabilities) %}
  <section class="hp-intro">
    <p class="hp-eyebrow">Your digital advisor</p>
    <h2 class="hp-intro__title">What are you planning for your home?</h2>
    <p class="hp-intro__lead">Tell me what you already use (Alexa, HomeKit, Google Home, Zigbee...) and your budget. Every price and compatibility claim comes from the catalog.</p>
    <ul class="hp-capabilities">
      {% for capability in capabilities %}<li>{{ capability }}</li>{% endfor %}
    </ul>
  </section>
{% endmacro %}

{% macro assistant_eyebrow() %}
  <p class="hp-eyebrow hp-eyebrow--advisor">HomePilot · Advisor</p>
{% endmacro %}
